{
  "manifest_version": 3,
  "name": "Trợ lý học tập · Canvas & SCORM",
  "version": "2.4.1",
  "description": "Canvas và SCORM: Gemini, Groq, Cloudflare, OpenRouter, 9Router trên VPS, tìm kiếm web và Chrome AI; key RAM theo phiên.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "file://*/*"
  ],
  "background": {
    "service_worker": "suite-background.js"
  },
  "action": {
    "default_popup": "suite-popup.html",
    "default_title": "Trợ lý học tập · Canvas & SCORM"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scorm.eduone.io.vn/*"
      ],
      "js": [
        "playback.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://scorm.eduone.io.vn/*"
      ],
      "js": [
        "core.js",
        "sources.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*quizzes/*",
        "http://*/*quizzes/*",
        "file://*/*"
      ],
      "exclude_matches": [
        "https://scorm.eduone.io.vn/*"
      ],
      "css": [
        "canvas/styles.css",
        "canvas-compact.css"
      ],
      "js": [
        "sources.js",
        "canvas-compat.js",
        "canvas/content.js",
        "canvas-controls.js",
        "canvas-focus-diagnostics.js"
      ],
      "run_at": "document_end"
    }
  ]
}
